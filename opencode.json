{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gengin-optimizer": {
      "type": "local",
      "command": ["python", "llmOpt/mcp_server.py"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": { "sort": "price" },
            "reasoningEffort": "xhigh"
          }
        },
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": { "sort": "price" },
            "reasoningEffort": "xhigh"
          }
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "deepseek-v4-pro": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
