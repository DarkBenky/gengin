# gengin-llmopt supervisor configuration template.
# Copy to llmOpt/.env and fill in real values. llmOpt/.env is gitignored.
#
# The supervisor uses a strict parser: blank lines and '#' comments are
# ignored, entries are KEY=VALUE, values may be wrapped in matching single or
# double quotes, and duplicate or unknown keys are rejected. The file is never
# shell-sourced.

# Repository and polling
GENGIN_REPO_URL=git@github.com:DarkBenky/gengin.git
GENGIN_INPUTS_DIR=/var/lib/gengin-llmopt/inputs
WATCH_REMOTE=origin
WATCH_BRANCH=main
POLL_INTERVAL_SECONDS=300
RUN_ON_START=false
MAX_SETUP_RETRIES=3
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800

# Agent and OpenRouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BUDGET_USD=5.00
SESSION_TIMEOUT_SECONDS=14400
BUDGET_POLL_SECONDS=15
KEY_EXPIRY_GRACE_SECONDS=900
TERMINATION_GRACE_SECONDS=30

# quick_ask tool (cheap advisory judgment model; see llmOpt/quick_ask.py).
# All optional - the defaults are sane for a supervised session.
# The tool answers typed questions through the TypeSafe Jev decision model
# (OpenRouter Decisions API) and returns calibrated probabilities - it never
# generates text and has no chat backend: pass choices/yes_no/questions,
# not prompts.
#QUICK_ASK_MODEL=typesafe/jev-1.13
#QUICK_ASK_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
#QUICK_ASK_TIMEOUT_SECONDS=30
#QUICK_ASK_MAX_CONTEXT_CHARS=24000
#QUICK_ASK_MAX_QUESTION_CHARS=8000
#QUICK_ASK_MAX_QUESTIONS=24
#QUICK_ASK_LOG=llmOpt/logs/quick_ask.jsonl

# Cost-aware route (optional): once a session's prompt is estimated to cross
# the token threshold, the proxy switches that session to the fallback for the
# rest of the conversation. Set BOTH keys to enable.
# The fallback is an OpenRouter model id, or `deepseek`/`ds` for the DIRECT
# DeepSeek API (that leg needs DEEPSEEK_API_KEY below / secrets.env).
#GENGIN_ROUTE_MAX_CONTEXT=99K
#GENGIN_ROUTE_FALLBACK_MODEL=deepseek
# or an OpenRouter id:
#GENGIN_ROUTE_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
# TTL of the proxy registration in seconds. Supervised sessions use it when
# set, otherwise SESSION_TIMEOUT_SECONDS + KEY_EXPIRY_GRACE_SECONDS; manual
# gengin-opt.sh runs default to 86400.
#GENGIN_ROUTE_TTL_SECONDS=86400
# Session spend cap for a chain: the proxy warns the model at 80%/95% of the
# cap and stops the session with HTTP 402 at the cap (costs come from the
# DeepSeek price table; off-peak-aware).
#GENGIN_ROUTE_BUDGET_USD=15
# Wait for DeepSeek's half-price window before starting a session (peak is
# Mon-Fri 01:00-04:00 and 06:00-10:00 UTC).
#GENGIN_OFFPEAK_WAIT=1

# VM runtime
GENGIN_DISPLAY=:99
LIBGL_ALWAYS_SOFTWARE=1
HEADLESS_MODE=xvfb
PREFLIGHT_BENCH_DURATION_SECONDS=2
REQUIRE_PERF=true

# Runtime storage (resolved under the repository root)
LOG_RETENTION_DAYS=30
STATE_DIR=llmOpt/state
SESSION_LOG_DIR=llmOpt/logs/sessions
RUN_DIR=llmOpt/run

# Unix identity that runs Hermes. Set to llmopt-agent for the two-user VM
# install (the supervisor launches it through the root-owned
# /usr/local/lib/gengin-llmopt/agent-launch helper). Leave empty for a
# single-user deployment (weaker: the agent could read the management key).
AGENT_USER=

# Virtual environment (created by setup-vm.sh) whose python has the `mcp`
# package; used as the MCP server interpreter in per-session configs.
# Leave empty to use the supervisor's own interpreter.
MCP_VENV=

# The OpenRouter management key and GITHUB_TOKEN are NOT stored here. They live
# in the root-only single file /etc/gengin-llmopt/secrets.env (EnvironmentFile
# for the systemd unit, sourced by the console launcher). This file is
# group-readable by the agent, so the management key must never be put here.
#   OPENROUTER_MANAGEMENT_KEY=<key>
#   GITHUB_TOKEN=<token>      # optional, for PR creation
