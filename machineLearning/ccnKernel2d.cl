enum ActivationFunction {
    ReLU,
    Sigmoid,
    Tanh,
    None,
};

__kernel void cnn2dFilter(
    __global float* input,
    const int channels,
    const int width,
    const int height,

    __global float* filterWeights,
    const float filterBias,
    const int filterSize,

    __global float* output,
    const int activation
) {
    const int x = get_global_id(0);
    const int y = get_global_id(1);

    const int pad = filterSize / 2;
    float sum = 0.0f;

    for (int j = 0; j < filterSize; j++) {
        int iy = y + j - pad;
        if (iy < 0 || iy >= height) continue;
        for (int i = 0; i < filterSize; i++) {
            int ix = x + i - pad;
            if (ix < 0 || ix >= width) continue;
            for (int k = 0; k < channels; k++) {
                sum += input[iy * width * channels + ix * channels + k]
                     * filterWeights[j * filterSize * channels + i * channels + k];
            }
        }
    }

    sum += filterBias;

    switch (activation) {
        case ReLU:    output[y * width + x] = max(sum, 0.0f); break;
        case Sigmoid: output[y * width + x] = 1.0f / (1.0f + exp(-sum)); break;
        case Tanh:    output[y * width + x] = tanh(sum); break;
        case None:    output[y * width + x] = sum; break;
    }
}

