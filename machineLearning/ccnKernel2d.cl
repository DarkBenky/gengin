// ---------------------------------------------------------------------------
// cnn2dFilter_w14_h14_c1_f3 -- generated by generateKernel.py (kernelGen v2, do not edit by hand)
// width=14 height=14 channels=1 filterSize=3
// params: input, filterWeights, filterBias, output, activation, accumulate
// ---------------------------------------------------------------------------
__kernel void cnn2dFilter_w14_h14_c1_f3(
    __global const float* input,
    __global const float* filterWeights,
    const float filterBias,
    __global float* output,
    const int activation,
    const int accumulate)
{
    const int x = get_global_id(0);
    const int y = get_global_id(1);
    if (x >= 14 || y >= 14) return;

    float sum = 0.0f;

    // tap (0, 0)
    if (y >= 1 && x >= 1)
    {
        const int base_0_0 = (y - 1) * 14 + (x - 1) * 1;
        sum += input[base_0_0] * filterWeights[0];
    }

    // tap (0, 1)
    if (y >= 1)
    {
        const int base_0_1 = (y - 1) * 14 + x * 1;
        sum += input[base_0_1] * filterWeights[1];
    }

    // tap (0, 2)
    if (y >= 1 && x < 13)
    {
        const int base_0_2 = (y - 1) * 14 + (x + 1) * 1;
        sum += input[base_0_2] * filterWeights[2];
    }

    // tap (1, 0)
    if (x >= 1)
    {
        const int base_1_0 = y * 14 + (x - 1) * 1;
        sum += input[base_1_0] * filterWeights[3];
    }

    // tap (1, 1)
    const int base_1_1 = y * 14 + x * 1;
    sum += input[base_1_1] * filterWeights[4];

    // tap (1, 2)
    if (x < 13)
    {
        const int base_1_2 = y * 14 + (x + 1) * 1;
        sum += input[base_1_2] * filterWeights[5];
    }

    // tap (2, 0)
    if (y < 13 && x >= 1)
    {
        const int base_2_0 = (y + 1) * 14 + (x - 1) * 1;
        sum += input[base_2_0] * filterWeights[6];
    }

    // tap (2, 1)
    if (y < 13)
    {
        const int base_2_1 = (y + 1) * 14 + x * 1;
        sum += input[base_2_1] * filterWeights[7];
    }

    // tap (2, 2)
    if (y < 13 && x < 13)
    {
        const int base_2_2 = (y + 1) * 14 + (x + 1) * 1;
        sum += input[base_2_2] * filterWeights[8];
    }

    sum += filterBias;

    float value = sum;
    switch (activation)
    {
        case ReLU:    value = max(sum, 0.0f); break;
        case Sigmoid: value = 1.0f / (1.0f + exp(-sum)); break;
        case Tanh:    value = tanh(sum); break;
        case None:    value = sum; break;
    }

    const int idx = y * 14 + x;
    output[idx] = accumulate ? output[idx] + value : value;
}

