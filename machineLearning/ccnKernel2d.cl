// cnn2dMaxPool_w14_h14_c1_p2 -- generated by generateKernel.py (do not edit by hand)
// width=14 height=14 channels=1 poolSize=2 -> 7x7
// params: input, output
// ---------------------------------------------------------------------------
__kernel void cnn2dMaxPool_w14_h14_c1_p2(
    __global const float* input,
    __global float* output)
{
    const int ox = get_global_id(0);
    const int oy = get_global_id(1);
